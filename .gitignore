# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
uv.lock

# Modal
.modal/

# Secrets / local env
.env
.env.*
*.secret
secrets/

# Model weights / checkpoints (never commit — pull from a Modal Volume)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local sample/inference artifacts fetched from the Modal Volume (large mp4s — never commit)
outputs/

# Throwaway local seg-map sanity-check previews (generated by the staging scripts' --sample flag)
scripts/_seg_preview/

# Harness scratch (renders/grids/logs fetched locally). Everything a run drops in the repo root
# is throwaway and regenerable from the Modal Volume, so none of it is a source of truth.
_samples_*/
_grid_*/
grid-output/
_tools/
_reskin_grid_*/
# Generated run-status pages (scripts/_h3_run_status.py) — regenerable from the Volume in one
# command, so the artifact is never the source of truth and must not be committed.
_h3_status*/

# Run logs and pidfiles. Detached dispatch writes these to the repo root; they quote dataset
# paths, captions, and subject names verbatim, so they are the single easiest way to leak
# private material into a commit. Never tracked.
_*.log
*.log
*.pid

# Private / licensed subject material — source footage, masks, staging, and every derived
# artifact. These dirs were previously only *uncommitted*, not ignored: a single `git add -A`
# would have committed multi-GB of licensed footage. Media never enters git; tracked artifacts
# (configs, docs, commit messages) must use a neutral codename, never the real name of the
# subject, property, or client.
_*_source/
_*_prep/
_*_stage/
_staging_*/
_segtest_*/
_mask_app_scratch/
_replaced_empty_seeds/
# Local-only reference-image cohorts + their path maps. The IMAGES already match the media
# patterns below, but the sidecar map that joins a file to its subject_id does NOT — and that
# map is exactly what must never enter a tracked file.
_*_refs/
_*_picker/

# Media of any kind, anywhere (zero media files are tracked today — keep it that way).
# Need a genuine repo asset? Add it deliberately with `git add -f`.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.gif
*.jpg
*.jpeg
*.png
*.webp

# Local-only client/property token list used by the packaged-spec leak fence
# (tests/test_harness_data.py). Client names must never live in a tracked file.
.property-tokens
